@model SaldoModel
@using PokeVault.Web.Domain
@using System.Globalization
@{var usuario=(UsuarioGestao)ViewBag.Usuario; ViewData["Title"]="Definir saldo";}
<section class="panel narrow"><div class="eyebrow">SALDO FICTÍCIO</div><h1>Definir saldo</h1><p><strong>@usuario.Nome</strong><br/>@usuario.Email</p><p>Saldo atual consultado: @usuario.Saldo?.ToString("C",CultureInfo.GetCultureInfo("pt-BR"))</p><p>O valor informado substitui o saldo atual. A diferença, o motivo e o responsável serão registrados.</p>
<form method="post" action="/admin/clientes/@usuario.UsuarioId/saldo">@Html.AntiForgeryToken()<div asp-validation-summary="All" role="alert" class="validation"></div>
<input asp-for="VersaoEsperada" type="hidden"/><label>Novo saldo fictício<input asp-for="NovoSaldo" type="number" step="0.01" min="0" max="9999999999.99" required/></label>
<label>Motivo<textarea asp-for="Motivo" maxlength="300" required rows="3"></textarea></label><button type="submit" disabled="@(ViewBag.Conflito==true)">Confirmar definição de saldo</button></form>
@if(ViewBag.Conflito==true){<p role="alert">Nada foi sobrescrito. Recarregue os dados antes de uma nova confirmação.</p><a class="button" href="/admin/clientes/@usuario.UsuarioId/saldo">Recarregar saldo e versão</a>}
<p><a href="/admin/clientes">Voltar aos clientes</a></p></section>
